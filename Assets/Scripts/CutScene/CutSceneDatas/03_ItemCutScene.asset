        fadeOutDuration: 0
      startPos: {x: 0, y: 0}
      endPos: {x: 0, y: 0}
      duration: 0
      ease: 0
    - sprite: {fileID: -483785915386784597, guid: 02abc685878685d4287df214cc7b86c4, type: 3}
      size: {x: 300, y: 300}
      fadeSettings:
        useFade: 0
        startDelay: 0
        fadeInDuration: 0
        fadeOutDuration: 0
      startPos: {x: 0, y: 0}
      endPos: {x: 0, y: 0}
      duration: 0
      ease: 0
  - Texts:
    - dialogueText: "\uC5F4\uC2EC\uD788 \uACF5\uBD80\uD558\uB824\uACE0 \uB178\uB825\uD588\uC5B4.\n\uC2DC\uD5D8
        \uC9C1\uC804 \uBCBC\uB77D\uCE58\uAE30\uB85C \uBE7D\uBE7D\uD55C \uB178\uD2B8\uB294
        \uC815\uB9D0 \uBFCC\uB4EF\uD588\uB358 \uAC70 \uAC19\uC544. \n\uC2DC\uD5D8
        \uACB0\uACFC\uC640 \uAD00\uB828\uC5C6\uC774."
      textPos: {x: 0, y: -300}
      textAlignment: 514
      fadeSettings:
        useFade: 1
        startDelay: 0
        fadeInDuration: 0.5
        fadeOutDuration: 0
    moveImages:
    - sprite: {fileID: -3048819314940337248, guid: 02abc685878685d4287df214cc7b86c4, type: 3}
      size: {x: 300, y: 300}
      fadeSettings:
        useFade: 0
        startDelay: 0
        fadeInDuration: 0
        fadeOutDuration: 0
      startPos: {x: 0, y: 0}
      endPos: {x: 0, y: 0}
      duration: 0
      ease: 0
  - Texts:
    - dialogueText: "\uB0B4\uAC00 \uAC00\uC7A5 \uC88B\uC544\uD558\uB358 \uC138\uC0C1\uC774
        \uC774 \uC791\uC740 \uAC8C\uC784\uAE30 \uC548\uC5D0 \uC788\uC5C8\uC5B4.\n\uBAA8\uB4E0
        \uAC78 \uC78A\uACE0 \uBE60\uC838\uB4E4 \uC218 \uC788\uB294 \uC138\uC0C1."
      textPos: {x: 0, y: -300}
      textAlignment: 514
      fadeSettings:
        useFade: 1
        startDelay: 0
        fadeInDuration: 0.5
        fadeOutDuration: 0
    moveImages:
    - sprite: {fileID: -6053909342743001456, guid: 02abc685878685d4287df214cc7b86c4, type: 3}
      size: {x: 300, y: 300}
      fadeSettings:
        useFade: 0
        startDelay: 0
        fadeInDuration: 0
        fadeOutDuration: 0
      startPos: {x: 0, y: 0}
      endPos: {x: 0, y: 0}
      duration: 0
      ease: 0
  - Texts:
    - dialogueText: "\uB300\uD559 \uC2DC\uC808 \uB0B4\uB0B4 \uB098\uC640 \uD568\uAED8\uD588\uB358
        \uD2BC\uD2BC\uD55C \uC6B4\uB3D9\uD654\uC57C.\n\uD568\uAED8 \uC9C0\uD558\uCCA0
        \uD658\uC2B9\uD1B5\uB85C\uB97C \uB2EC\uB838\uC5B4. "
      textPos: {x: 0, y: -300}
      textAlignment: 514
      fadeSettings:
        useFade: 1
        startDelay: 0
        fadeInDuration: 0.5
        fadeOutDuration: 0
    moveImages:
    - sprite: {fileID: 3633937587237763438, guid: 02abc685878685d4287df214cc7b86c4, type: 3}
      size: {x: 300, y: 300}
      fadeSettings:
        useFade: 0
        startDelay: 0
        fadeInDuration: 0
        fadeOutDuration: 0
      startPos: {x: 0, y: 0}
      endPos: {x: 0, y: 0}
      duration: 0
      ease: 0
  - Texts:
    - dialogueText: "\uB3D9\uC544\uB9AC\uBC29\uC5D0\uC11C \uD63C\uC790 \uC5F0\uC8FC\uD558\uACE0,
        \uB610 \uC5F0\uC8FC\uD588\uC5B4.\n\uADF8\uB7EC\uB2E4\uAC00 \uC5B4\uB290\uB0A0
        \uBB34\uB300 \uC704\uC5D0\uC11C \uB2E4\uAC19\uC774 \uACF5\uC5F0\uD588\uC744
        \uB54C\uB97C \uC78A\uC9C0 \uBABB \uD574."
      textPos: {x: 0, y: -300}
      textAlignment: 514
