  - Texts:
    - dialogueText: "\uCC98\uC74C\uC5D0 \uC815\uB9D0 \uC790\uB791\uC2A4\uB7FD\uAC8C
        \uC785\uC5C8\uC5B4.\n\uB0B4\uAC00 \uADF8 \uAC04\uD310\uC758 \uBB34\uAC8C\uBCF4\uB2E4
        \uBABB\uB09C \uC0AC\uB78C\uC774\uB77C\uACE0 \uB290\uAEF4\uC9C0\uAE30 \uC804\uAE4C\uC9C0\uB294."
      textPos: {x: 0, y: -300}
      textAlignment: 514
